# EXEMPLO: campos vazios intencionais, sem credenciais reais.
# Preencher localmente com configuracao do DESTINO. Nunca versionar .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# IA (Google Gemini). Somente servidor: nunca usar prefixo VITE_.
GEMINI_API_KEY=
# Opcionais: padrao gemini-3.1-flash-image e gemini-3.5-flash-lite.
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=
# Opcional: vazio = padrao; 2K ou 4K dao mais resolucao e custam mais.
GEMINI_IMAGE_SIZE=
# Opcional: cliente administrativo gerado, nao usado no CRUD normal.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: conexao privilegiada para migracoes no DESTINO.
LOVABLE_DB_MIGRATION_URL=
# Opcionais: helper de cron incluido; nenhum agendamento confirmado.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
# Nome legado presente na lista de segredos; codigo atual usa PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
# Presente na lista de segredos; config Drizzle usa LOVABLE_DB_MIGRATION_URL.
SUPABASE_DB_URL=
